#!/usr/bin/env bash
# Git pre-commit hook: runs the local check before every commit
# (DESIGN.md §13, §15 item 3) so it cannot be forgotten.
#
# Activate once per clone:
#     git config core.hooksPath tools/git-hooks
# The hook lives in the repo rather than .git/hooks/ so there is no copy
# to drift out of date.
#
# It checks the working tree, not only what is staged. A partial commit
# whose staged half is broken but whose unstaged half fixes it will pass.
exec "$(git rev-parse --show-toplevel)/tools/check.sh"
